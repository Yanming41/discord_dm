DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# 可选：论坛频道(forum channel)ID，不填就不启用论坛相关功能。没有现成的论坛频道可以先不填，
# 启动脚本后在控制台敲 `mkforum <频道名>` 建一个，把打印出来的ID填到这里再重启。
DISCORD_FORUM_CHANNEL_ID=
# 强烈建议配置：你自己的Discord用户ID(右键自己头像→复制用户ID，要先在Discord的"高级"设置里
# 开开发者模式才有这个选项)。配了之后，只有你发"睡眠"/"sleep"才会让电脑睡眠；不配的话频道里
# 任何人发这两个词都会触发，只有确定这个频道真的只有你自己能看到时才可以不配。
DISCORD_OWNER_ID=
